# Example server block for /www/server/panel/vhost/nginx/47.239.74.87_21114.conf
# Back up the active configuration before merging this example. Keep any
# certificate-validation includes generated by BT Panel.

server {
    listen 21114;
    server_name 47.239.74.87;

    root /www/wwwroot/testProject;
    index index.html;

    # The management SPA is built and deployed independently from the public site.
    location = /manage-app {
        return 308 /manage-app/;
    }

    location ^~ /manage-app/ {
        try_files $uri $uri/ /manage-app/index.html;
        add_header Cache-Control "no-cache" always;
    }

    # Canonical management URL. Spring receives the /manage prefix unchanged.
    location = /manage {
        return 308 /manage/;
    }

    location ^~ /manage/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_buffering off;
        add_header Cache-Control "no-store" always;
    }

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        add_header Cache-Control "no-store" always;
    }

    # Backend source is deployed outside the web root. Keep this deny rule as
    # defense in depth in case a future upload accidentally creates the path.
    location ^~ /backend/ {
        return 404;
    }

    # Next's hashed build assets are immutable. Character models and other
    # unversioned public assets use a shorter cache so replacements propagate.
    location ^~ /_next/static/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location ~* \.(?:css|js|mjs|png|jpe?g|gif|webp|avif|svg|ico|woff2?|glb)$ {
        try_files $uri =404;
        expires 1h;
        add_header Cache-Control "public";
        access_log off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~ ^/(\.user\.ini|\.htaccess|\.git|\.env|\.svn|\.project|LICENSE|README\.md) {
        return 404;
    }

    location ^~ /.well-known/ {
        allow all;
    }

    access_log /www/wwwlogs/47.239.74.87_21114.log;
    error_log  /www/wwwlogs/47.239.74.87_21114.error.log;
}
