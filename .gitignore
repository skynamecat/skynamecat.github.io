# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/frontend/node_modules
/admin-frontend/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/frontend/.next/
/frontend/.vinext/
/frontend/out/

# misc
.DS_Store
.idea/
*.iml
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/frontend/dist/
/admin-frontend/dist/
/admin-frontend/*.tsbuildinfo
/admin-frontend/vite.config.js
/admin-frontend/vite.config.d.ts
/frontend/.wrangler/
/outputs/
/work/

# Java backend build output and machine-specific deployment snapshots
/backend/target/
/deploy/nginx-testproject.active.conf

# Disposable local conversion/build work
/tmp/

# Imported 3D experiments are migration sources, not production artifacts
/testDeepSeekHarness/
